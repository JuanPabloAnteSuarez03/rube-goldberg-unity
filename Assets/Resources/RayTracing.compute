// Trazador de rayos en tiempo real para la máquina de Rube Goldberg.
// Primarios + sombras + una reflexión + oclusión ambiental.
// Funciona con cualquier GPU que soporte compute shaders (no requiere DXR/HDRP).

#pragma kernel CSMain

struct Sphere
{
    float4 centroRadio;     // xyz = centro, w = radio
    float4 albedoBrillo;    // rgb = albedo (lineal), w = brillo
    float4 emision;         // rgb = emisión (lineal)
};

struct Box
{
    float4 centro;          // xyz = centro
    float4 medios;          // xyz = semiextensiones
    float4 rotacion;        // quaternion (x, y, z, w)
    float4 albedoBrillo;
    float4 emision;
};

StructuredBuffer<Sphere> _Esferas;
StructuredBuffer<Box> _Cajas;
int _NumEsferas;
int _NumCajas;

float3 _CamaraPos;
float3 _CamaraDerecha;
float3 _CamaraArriba;
float3 _CamaraAdelante;
float _TanMedioFov;
float _Aspecto;
int _Ancho;
int _Alto;

float3 _SolDir;         // dirección hacia el sol
float3 _SolColor;
float3 _Ambiente;
float3 _Cielo;
float3 _Horizonte;
float3 _SueloAlbedo;
float3 _SueloEmision;

RWTexture2D<float4> _Resultado;

struct Hit
{
    float  t;
    float3 n;
    float3 albedo;
    float  brillo;
    float3 emision;
    bool   golpe;
};

float3 Rotar(float3 q, float w, float3 v)
{
    return v + 2.0 * cross(q, cross(q, v) + w * v);
}

bool IntersecEsfera(Sphere e, float3 ro, float3 rd, out float t, out float3 n)
{
    t = 0.0;
    n = float3(0, 1, 0);
    float3 oc = ro - e.centroRadio.xyz;
    float r = e.centroRadio.w;
    float b = dot(oc, rd);
    float c = dot(oc, oc) - r * r;
    float disc = b * b - c;
    if (disc < 0.0) return false;

    float sq = sqrt(disc);
    float t0 = -b - sq;
    float t1 = -b + sq;
    t = t0 > 0.001 ? t0 : t1;
    if (t <= 0.001) return false;

    n = normalize(ro + rd * t - e.centroRadio.xyz);
    return true;
}

bool IntersecCaja(Box b, float3 ro, float3 rd, out float t, out float3 n)
{
    t = 0.0;
    n = float3(0, 1, 0);

    float3 rel = ro - b.centro.xyz;
    float3 lro = Rotar(-b.rotacion.xyz, b.rotacion.w, rel);
    float3 lrd = Rotar(-b.rotacion.xyz, b.rotacion.w, rd);

    float3 m = max(b.medios.xyz, float3(0.0005, 0.0005, 0.0005));
    float3 inv = 1.0 / lrd;
    float3 ta = (-m - lro) * inv;
    float3 tb = ( m - lro) * inv;
    float3 tmin = min(ta, tb);
    float3 tmax = max(ta, tb);

    float tn = max(max(tmin.x, tmin.y), tmin.z);
    float tf = min(min(tmax.x, tmax.y), tmax.z);

    if (tf < max(tn, 0.0)) return false;

    t = tn > 0.001 ? tn : tf;
    if (t <= 0.001) return false;

    float3 lp = lro + lrd * t;
    float3 a = abs(lp) / m;
    float3 ln = float3(0, 0, 0);

    if (a.x >= a.y && a.x >= a.z)      ln.x = lp.x > 0.0 ? 1.0 : -1.0;
    else if (a.y >= a.z)               ln.y = lp.y > 0.0 ? 1.0 : -1.0;
    else                               ln.z = lp.z > 0.0 ? 1.0 : -1.0;

    n = normalize(Rotar(b.rotacion.xyz, b.rotacion.w, ln));
    return true;
}

Hit Trace(float3 ro, float3 rd)
{
    Hit h;
    h.t = 1e20;
    h.n = float3(0, 1, 0);
    h.albedo = float3(0.7, 0.7, 0.7);
    h.brillo = 0.1;
    h.emision = float3(0, 0, 0);
    h.golpe = false;

    // Suelo infinito (y = 0)
    if (abs(rd.y) > 0.00001)
    {
        float tSuelo = -ro.y / rd.y;
        if (tSuelo > 0.001 && tSuelo < h.t)
        {
            h.t = tSuelo;
            h.n = float3(0, 1, 0);
            h.albedo = _SueloAlbedo;
            h.brillo = 0.28;
            h.emision = _SueloEmision;
            h.golpe = true;
        }
    }

    for (int i = 0; i < _NumEsferas; i++)
    {
        float t = 0.0; float3 n = float3(0, 1, 0);
        if (IntersecEsfera(_Esferas[i], ro, rd, t, n) && t < h.t)
        {
            h.t = t;
            h.n = n;
            h.albedo = _Esferas[i].albedoBrillo.rgb;
            h.brillo = _Esferas[i].albedoBrillo.a;
            h.emision = _Esferas[i].emision.rgb;
            h.golpe = true;
        }
    }

    for (int j = 0; j < _NumCajas; j++)
    {
        float t = 0.0; float3 n = float3(0, 1, 0);
        if (IntersecCaja(_Cajas[j], ro, rd, t, n) && t < h.t)
        {
            h.t = t;
            h.n = n;
            h.albedo = _Cajas[j].albedoBrillo.rgb;
            h.brillo = _Cajas[j].albedoBrillo.a;
            h.emision = _Cajas[j].emision.rgb;
            h.golpe = true;
        }
    }

    return h;
}

bool Ocluido(float3 ro, float3 rd, float maxDist)
{
    for (int i = 0; i < _NumEsferas; i++)
    {
        float t = 0.0; float3 n = float3(0, 1, 0);
        if (IntersecEsfera(_Esferas[i], ro, rd, t, n) && t > 0.01 && t < maxDist) return true;
    }

    for (int j = 0; j < _NumCajas; j++)
    {
        float t = 0.0; float3 n = float3(0, 1, 0);
        if (IntersecCaja(_Cajas[j], ro, rd, t, n) && t > 0.01 && t < maxDist) return true;
    }

    return false;
}

float3 CieloColor(float3 rd)
{
    float g = saturate(rd.y * 0.5 + 0.5);
    float3 c = lerp(_Horizonte, _Cielo, pow(g, 0.85));

    // Disco del sol
    float s = max(dot(rd, _SolDir), 0.0);
    c += _SolColor * pow(s, 800.0) * 4.0;
    return c;
}

float3 Iluminar(float3 ro, float3 rd, Hit h)
{
    float3 p = ro + rd * h.t + h.n * 0.004;

    float3 tangente = normalize(cross(h.n, abs(h.n.y) < 0.9 ? float3(0, 1, 0) : float3(1, 0, 0)));
    float3 bitangente = cross(h.n, tangente);

    // Dos rayos de sombra muy cercanos = sombra ligeramente suave.
    float sombra = 0.0;
    sombra += Ocluido(p, normalize(_SolDir + tangente * 0.022), 60.0) ? 0.0 : 1.0;
    sombra += Ocluido(p, normalize(_SolDir - tangente * 0.022), 60.0) ? 0.0 : 1.0;
    sombra *= 0.5;

    float ndl = max(dot(h.n, _SolDir), 0.0);
    float3 color = h.albedo * (_Ambiente + _SolColor * ndl * sombra);

    // Brillo especular
    float3 v = -rd;
    float3 hv = normalize(_SolDir + v);
    float espec = pow(max(dot(h.n, hv), 0.0), 8.0 + 120.0 * h.brillo) * (0.05 + 0.55 * h.brillo);
    color += _SolColor * espec * sombra * ndl;

    // Una reflexión (rayo secundario)
    if (h.brillo > 0.12)
    {
        float3 r = reflect(rd, h.n);
        Hit rh = Trace(p, r);
        float3 reflejo;

        if (rh.golpe)
        {
            float3 rp = p + r * rh.t + rh.n * 0.004;
            float ndl2 = max(dot(rh.n, _SolDir), 0.0);
            float sh2 = Ocluido(rp, _SolDir, 60.0) ? 0.0 : 1.0;
            reflejo = rh.albedo * (_Ambiente + _SolColor * ndl2 * sh2) + rh.emision;

            float3 hv2 = normalize(_SolDir - r);
            reflejo += _SolColor * pow(max(dot(rh.n, hv2), 0.0), 12.0) * rh.brillo * sh2 * ndl2;
        }
        else
        {
            reflejo = CieloColor(r);
        }

        float fres = 0.04 + 0.96 * pow(1.0 - max(dot(-rd, h.n), 0.0), 5.0);
        color = lerp(color, reflejo, saturate(h.brillo * (0.20 + 0.80 * fres)));
    }

    color += h.emision;

    // Oclusión ambiental con dos rayos
    float ao1 = Ocluido(p, normalize(h.n + tangente * 0.65 + bitangente * 0.35), 1.6) ? 0.0 : 1.0;
    float ao2 = Ocluido(p, normalize(h.n - tangente * 0.25 + bitangente * 0.75), 1.6) ? 0.0 : 1.0;
    float ao = 0.5 * (ao1 + ao2);
    color *= lerp(1.0, ao, 0.30);

    return color;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Ancho || (int)id.y >= _Alto) return;

    float2 uv = (float2(id.xy) + 0.5) / float2(_Ancho, _Alto) * 2.0 - 1.0;

    float3 rd = normalize(_CamaraAdelante
                        + _CamaraDerecha * (uv.x * _TanMedioFov * _Aspecto)
                        + _CamaraArriba  * (uv.y * _TanMedioFov));

    Hit h = Trace(_CamaraPos, rd);

    float3 color;
    if (h.golpe) color = Iluminar(_CamaraPos, rd, h);
    else         color = CieloColor(rd);

    // El proyecto está en espacio de color Gamma.
    color = pow(saturate(color), 1.0 / 2.2);

    _Resultado[id.xy] = float4(color, 1.0);
}
